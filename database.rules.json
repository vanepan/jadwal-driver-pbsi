    },
    "pettyCashNors": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashCycles": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashSettings": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashAudit": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "overtimeUnits": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeEmployees": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRates": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRateVersions": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeHolidays": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRecords": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeDailySummary": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeMonthlySummary": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeAudit": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeBudget": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeReportHistory": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeClosing": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeArchive": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "userProfiles": {
      ".read": "auth != null",
      ".write": "false"
    },

    "users": {
      // v1.30.9.2 — production incident fix: RTDB evaluates .read only at
      // the exact requested path and its ancestors, never at a descendant.
      // js/users.js subscribes at this collection path (subscribeNode
      // ('users', ...)), which the $username-only child rule below never
      // covered — root .read is false, so that subscription was silently
      // denied for every role, admin included. Deliberately admin/
      // adminEquivalent ONLY, no self-branch: self access stays scoped to
      // one's own child record, never the whole roster.
      ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
      "$username": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.uid === $username",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (auth.uid === $username && newData.child('role').val() === data.child('role').val() && newData.child('active').val() === data.child('active').val() && newData.child('archived').val() === data.child('archived').val())"
      }
    },

    "assignments": {
      ".read": "auth != null",
      "$assignmentId": {
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (data.exists() && newData.child('driverUsername').val() === data.child('driverUsername').val() && newData.child('requestId').val() === data.child('requestId').val() && data.child('status').val() !== 'completed' && data.child('status').val() !== 'cancelled' && ((auth.token.role === 'driver' && data.child('driverUsername').val() === auth.uid) || (auth.token.role === 'bidang' && (!data.child('driver').exists() || data.child('driver').val() === '') && data.child('requestId').val() !== null && root.child('driver_requests').child(data.child('requestId').val()).child('requesterId').val() === auth.uid)))"
      }
    },

    "driver_requests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (auth.token.role === 'bidang' && ((!data.exists() && newData.child('requesterId').val() === auth.uid) || (data.exists() && data.child('requesterId').val() === auth.uid && newData.child('requesterId').val() === auth.uid)))"
      }
    },

    "drivers": {
      ".read": "auth != null",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "vehicles": {
      ".read": "auth != null",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    // v1.30.9.10 — Custom Role Protected Permission Security Hardening.
    // Pre-existing gap found during Phase 4's (v1.30.9.9) Final Review: this
    // node had NO .validate at all — a Custom Role's permissions array
    // feeds directly into permission-service.js's BASE grant for every user
    // holding that role, so an admin could (through the ordinary, already-
    // shipped Custom Role editor, or by cloning the built-in "Admin" System
    // Role, which legitimately holds both ids in its OWN base grant) create
    // a Custom Role that silently grants real system.admin/
    // system.users.manage to everyone assigned it. .read/.write are
    // UNCHANGED (this task's own instruction: do not weaken existing
    // authorization, do not add a self-write path) — only the new
    // "permissions" -> "$index" .validate clause is added, mirroring
    // userPermissionOverrides'/rolePermissionOverrides' identical per-
    // element pattern. This governs the resulting array state for ANY
    // write shape that touches it — a full record set(), a permissions-
    // only replacement, a deep single-index write, or a multi-location
    // update() — RTDB re-evaluates every .validate rule along the write
    // path against the RESULTING data, not just the literally-touched
    // leaf, so none of those shapes can smuggle either id in.
    "customRoles": {
      "$roleId": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || (auth != null && data.child('archived').val() !== true)",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin' && newData.val() !== 'system.users.manage'"
          }
        }
      },
      ".write": "auth.token.role === 'admin'"
    },

    "userPermissionOverrides": {
      "$username": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.uid === $username",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".validate": "newData.hasChildren(['permissions']) && !newData.hasChild('role') && !newData.hasChild('adminEquivalent') && !newData.hasChild('pin') && !newData.hasChild('pinHash') && !newData.hasChild('active') && !newData.hasChild('archived')",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin'"
          }
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },

    // Role-Level Permission Assignment, Phase 4 (v1.30.9.9) — bulk
    // "Role Additional Permissions" applied to every user holding a given
    // SYSTEM role (Custom Roles already have their own mutable permission
    // set via /customRoles and never target this node — enforced at the
    // application layer by role-permission-overrides-rules.js#
    // isValidRoleOverrideTarget(), not by this rule, which has no way to
    // distinguish a System Role id from a Custom Role id by shape alone).
    //
    // READ has TWO branches, deliberately: admin/adminEquivalent (the two
    // admin UIs — Role Management and User Management's Individual
    // Permission panel — read one role at a time, on selection) AND
    // `auth.token.role === $roleId`, a per-role self-read exactly
    // mirroring userPermissionOverrides' `auth.uid === $username` branch
    // above, translated from per-user identity to per-role identity since
    // a role is shared by many users and has no uid of its own. This
    // self-read is NOT optional: without it, a non-admin session could
    // never resolve its OWN role's Additional grants, and the feature
    // could not function for anyone but admin — the exact same reasoning
    // that justified userPermissionOverrides' self-branch. A role's node
    // is never readable by a DIFFERENT role's session (cross-role reads
    // stay denied) and never by an unauthenticated client.
    //
    // WRITE is admin/adminEquivalent ONLY — no self-write branch of any
    // kind (no role ever legitimately writes its own bulk grants; only an
    // administrator does), matching userPermissionOverrides' "no self-
    // write branch at all" discipline exactly.
    //
    // VALIDATE mirrors userPermissionOverrides' shape byte-for-byte, with
    // TWO forbidden permission ids instead of one — 'system.users.manage'
    // is a hard boundary here (Phase 4's own brief), unlike Individual
    // Permission Assignment where it is only a UI-layer exclusion.
    "rolePermissionOverrides": {
      "$roleId": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.token.role === $roleId",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".validate": "newData.hasChildren(['permissions']) && !newData.hasChild('role') && !newData.hasChild('adminEquivalent') && !newData.hasChild('pin') && !newData.hasChild('pinHash') && !newData.hasChild('active') && !newData.hasChild('archived')",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin' && newData.val() !== 'system.users.manage'"
          }
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },

    "v2_sarpras": {
      "import_sessions": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "import_batches": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "file_storage": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "composer_documents": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      }
    },

    // v1.30.9.11 — Phase 5, closing a gap found during Phase 5A's own
    // investigation: this node has had NO rule at all since the
    // persistence layer was introduced (v1.16.4.11-rc.1) — confirmed via
    // `git log -S"dispatchIntelligence" -- database.rules.json` (zero
    // hits, ever) and via a direct fetch of the LIVE deployed rules
    // (byte-identical to this file before this change). Root is
    // deny-by-default, so every read/write has been silently denied for
    // everyone, including admin, since whichever prior deploy hardened
    // the root — real production data up to 2026-08-11 proves this
    // subsystem DID persist successfully before that point; it has been
    // effectively frozen since. js/services/dispatch-intelligence-
    // persistence.js's own read-through/write-through pair (override
    // logs, request recommendation history, capacity snapshots) is
    // genuinely admin/ops-sensitive operational history, not a public or
    // broadly-authenticated-readable config store — deliberately
    // NARROWER than this file's usual "admin/developer/adminEquivalent
    // read" convention (no 'developer' branch): this task's own explicit
    // decision tree specified admin/adminEquivalent only for both read
    // and write, and unlike the sibling analytics/audit nodes above,
    // nothing in the application currently needs a 'developer' session to
    // read this node, so it is not added speculatively.
    "dispatchIntelligence": {
      ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "engineering": {
      "assignments": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".indexOn": ["status", "priority", "category"],
        "$assignmentId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || ((auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member') && data.exists() && newData.exists() && data.child('status').val() !== 'verified')",
          ".validate": "newData.hasChildren(['id', 'status'])"
        }
      },
      "notifications": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'"
      },
      "settings": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer'"
      },
      "workReports": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'"
      }
    },

    "gudang": {
      "items": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$itemId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && (!data.exists() || newData.child('itemType').val() === data.child('itemType').val())",
          ".validate": "newData.hasChildren(['itemId', 'name', 'itemType', 'active', 'normalizedName', 'searchTokens', 'createdAt']) && newData.child('itemId').val() === $itemId"
        }
      },

      "movements": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$movementId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && !data.exists()",
          ".validate": "newData.hasChildren(['movementId', 'itemId', 'type', 'quantityDelta', 'reason', 'actorId', 'createdAt']) && newData.child('movementId').val() === $movementId && newData.child('quantityDelta').isNumber()"
        }
      },

      "assets": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$assetId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['assetId', 'itemId', 'identity', 'status', 'createdAt']) && newData.child('assetId').val() === $assetId"
        }
      },

      "assetHistory": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$historyId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && !data.exists()",
          ".validate": "newData.hasChildren(['historyId', 'assetId', 'eventType', 'actorId', 'reason', 'occurredAt']) && newData.child('historyId').val() === $historyId"
        }
      },

      "locations": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$locationId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['locationId', 'name', 'createdAt']) && newData.child('locationId').val() === $locationId"
        }
      },

      "departments": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$departmentId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['departmentId', 'name', 'createdAt']) && newData.child('departmentId').val() === $departmentId"
        }
      },

      "stockProjection": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$itemId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['itemId', 'quantity', 'rebuiltAt', 'consistent']) && newData.child('itemId').val() === $itemId && newData.child('quantity').isNumber()"
        }
      }
    }
  }
}
