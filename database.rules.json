{
  "rules": {
    ".read": "false",
    ".write": "false",

    "events": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "false"
    },

    "telegram_deliveries": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "false"
    },

    "notifications": {
      ".write": "false",
      "$recipientId": {
        ".read": "auth.uid === $recipientId || auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true"
      }
    },

    "notification_deliveries": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "false"
    },

    "push_subscriptions": {
      ".write": "false",
      "$userId": {
        ".read": "auth.uid === $userId || auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true"
      }
    },

    "notification_state": {
      ".write": "false",
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    "reminders": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "false",
      ".indexOn": ["fireAt"]
    },

    "logs": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    },

    "analytics_exports": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      "$exportId": {
        ".write": "auth != null && !data.exists()"
      }
    },

    "feature_flags": {
      ".read": "auth != null",
      ".write": "false"
    },

    // V2 Sarpras Intelligence Phase 1 — durable multi-turn generation state.
    // STAGED: this rule ships in the repo but is NOT deployed with Phase 1 —
    // it gets its own security review before any `firebase deploy --only
    // database`. Server-only write (a conversation callable writes via the
    // Admin SDK, which bypasses rules); a viewer READs only their own
    // sessions ($convId.actorId === auth.uid). Same shape as
    // push_subscriptions / notification_state.
    "intelligence_conversations": {
      ".write": "false",
      ".indexOn": ["actorId"],
      "$convId": {
        ".read": "auth != null && (data.child('actorId').val() === auth.uid || auth.token.role === 'admin' || auth.token.adminEquivalent === true)"
      }
    },

    // V2 Sarpras Intelligence — Phase 4 server-owned NOR draft & review.
    // Mirrors intelligence_conversations byte-for-byte: the intelligenceNorDraft
    // Cloud Function (Admin SDK) is the ONLY writer (".write": false), and a
    // user may .read ONLY their own draft (ownerId === auth.uid), plus the
    // admin / adminEquivalent tier. NOT a publication node — the record itself forces
    // numbering.publishedNumber null.
    "intelligence_nor_drafts": {
      ".write": "false",
      ".indexOn": ["ownerId"],
      "$draftId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || auth.token.role === 'admin' || auth.token.adminEquivalent === true)"
      }
    },

    // V2 Sarpras Intelligence — Phase 5 CANONICAL NOR Registry & human
    // publication. Mirrors intelligence_nor_drafts byte-for-byte: the
    // intelligenceNorRegistry Cloud Function (Admin SDK) is the ONLY writer
    // (".write": false), and a user may .read ONLY their own record
    // (ownerId === auth.uid), plus the admin / adminEquivalent tier. The
    // official-number counter (/intelligence_nor_registry_counters) has NO
    // rule of its own — the root ".read/.write": false deny-by-default
    // covers it, exactly as it does /reimbursement_counters (server-only).
    "intelligence_nor_registry": {
      ".write": "false",
      ".indexOn": ["ownerId"],
      "$norId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || auth.token.role === 'admin' || auth.token.adminEquivalent === true)"
      }
    },

    // V2 Sarpras Intelligence — Phase 5.x.1 NOR & Memorandum Corpus
    // Acquisition Foundation. STAGED: these two blocks ship in the repo
    // but are NOT deployed with Phase 5.x.1 — they get their own
    // `firebase deploy --only database` review in Phase 5.x.2, together
    // with wiring intelligenceCorpus into functions/index.js. Mirrors
    // intelligence_nor_registry byte-for-byte: the intelligenceCorpus
    // Cloud Function (Admin SDK) is the ONLY writer (".write": false), and
    // a user may .read ONLY their own record (ownerId === auth.uid), plus
    // the admin / adminEquivalent tier. Historical organizational documents may be
    // sensitive — corpus access is controlled organizational data.
    "intelligence_corpus_documents": {
      ".write": "false",
      ".indexOn": ["ownerId"],
      "$documentId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || auth.token.role === 'admin' || auth.token.adminEquivalent === true)"
      }
    },
    "intelligence_corpus_observations": {
      ".write": "false",
      ".indexOn": ["documentId", "ownerId"],
      "$observationId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || auth.token.role === 'admin' || auth.token.adminEquivalent === true)"
      }
    },

    // V2 Sarpras Intelligence — Phase 5.x.5 PBSI NOR Style Guide (the FIRST
    // authority layer: explicit human-approved organizational writing
    // rules). STAGED: this block ships in the repo but is NOT deployed with
    // Phase 5.x.5 — it gets its own `firebase deploy --only database`
    // review together with wiring intelligenceStyleGuide into
    // functions/index.js. The intelligenceStyleGuide Cloud Function (Admin
    // SDK) is the ONLY writer (".write": false). Unlike the corpus nodes
    // this is ORGANIZATION-WIDE, not owner-scoped: the Style Guide is
    // authoritative organizational data and every effective admin may read
    // the whole guide. `.indexOn` supports the status / category /
    // documentType queries.
    "intelligence_style_guide": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)",
      ".write": "false",
      ".indexOn": ["status", "category", "documentType"]
    },

    // V2 Sarpras Intelligence — Phase 5.x.6 PBSI Visual Template System
    // (the VISUAL authority layer: explicit human-approved document-layout
    // templates). STAGED: this block ships in the repo but is NOT deployed
    // with Phase 5.x.6 — it gets its own `firebase deploy --only database`
    // review together with wiring intelligenceVisualTemplate into
    // functions/index.js. The intelligenceVisualTemplate Cloud Function
    // (Admin SDK) is the ONLY writer (".write": false). Like
    // intelligence_style_guide this is ORGANIZATION-WIDE, not owner-scoped:
    // authoritative organizational data, every effective admin may read
    // the whole system. `.indexOn` supports the status / documentType
    // queries.
    "intelligence_visual_templates": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)",
      ".write": "false",
      ".indexOn": ["status", "documentType"]
    },

    "settings": {
      "operations": {
        ".read": "auth != null",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "pettyCashExpenses": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashNors": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashCycles": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashSettings": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "pettyCashAudit": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "overtimeUnits": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeEmployees": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRates": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRateVersions": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeHolidays": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeRecords": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeDailySummary": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeMonthlySummary": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeAudit": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeBudget": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeReportHistory": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeClosing": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },
    "overtimeArchive": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "userProfiles": {
      ".read": "auth != null",
      ".write": "false"
    },

    "users": {
      // v1.30.9.2 — production incident fix: RTDB evaluates .read only at
      // the exact requested path and its ancestors, never at a descendant.
      // js/users.js subscribes at this collection path (subscribeNode
      // ('users', ...)), which the $username-only child rule below never
      // covered — root .read is false, so that subscription was silently
      // denied for every role, admin included. Deliberately admin/
      // adminEquivalent ONLY, no self-branch: self access stays scoped to
      // one's own child record, never the whole roster.
      ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
      "$username": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.uid === $username",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (auth.uid === $username && newData.child('role').val() === data.child('role').val() && newData.child('active').val() === data.child('active').val() && newData.child('archived').val() === data.child('archived').val())"
      }
    },

    "assignments": {
      ".read": "auth != null",
      "$assignmentId": {
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (data.exists() && newData.child('driverUsername').val() === data.child('driverUsername').val() && newData.child('requestId').val() === data.child('requestId').val() && data.child('status').val() !== 'completed' && data.child('status').val() !== 'cancelled' && ((auth.token.role === 'driver' && data.child('driverUsername').val() === auth.uid) || (auth.token.role === 'bidang' && (!data.child('driver').exists() || data.child('driver').val() === '') && data.child('requestId').val() !== null && root.child('driver_requests').child(data.child('requestId').val()).child('requesterId').val() === auth.uid)))"
      }
    },

    "driver_requests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || (auth.token.role === 'bidang' && ((!data.exists() && newData.child('requesterId').val() === auth.uid) || (data.exists() && data.child('requesterId').val() === auth.uid && newData.child('requesterId').val() === auth.uid)))"
      }
    },

    "drivers": {
      ".read": "auth != null",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "vehicles": {
      ".read": "auth != null",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    // v1.30.9.10 — Custom Role Protected Permission Security Hardening.
    // Pre-existing gap found during Phase 4's (v1.30.9.9) Final Review: this
    // node had NO .validate at all — a Custom Role's permissions array
    // feeds directly into permission-service.js's BASE grant for every user
    // holding that role, so an admin could (through the ordinary, already-
    // shipped Custom Role editor, or by cloning the built-in "Admin" System
    // Role, which legitimately holds both ids in its OWN base grant) create
    // a Custom Role that silently grants real system.admin/
    // system.users.manage to everyone assigned it. .read/.write are
    // UNCHANGED (this task's own instruction: do not weaken existing
    // authorization, do not add a self-write path) — only the new
    // "permissions" -> "$index" .validate clause is added, mirroring
    // userPermissionOverrides'/rolePermissionOverrides' identical per-
    // element pattern. This governs the resulting array state for ANY
    // write shape that touches it — a full record set(), a permissions-
    // only replacement, a deep single-index write, or a multi-location
    // update() — RTDB re-evaluates every .validate rule along the write
    // path against the RESULTING data, not just the literally-touched
    // leaf, so none of those shapes can smuggle either id in.
    // v1.30.9.12 — customRoles collection-read fix (the gap flagged and
    // reserved since v1.30.9.2, carried forward untouched through v1.30.9.4,
    // v1.30.9.8, and v1.30.9.11's own Phase 5 scope). Same root cause and
    // same fix shape as the v1.30.9.2 /users incident: js/role-management/
    // custom-roles-store.js#initCustomRolesStore() subscribes at the
    // /customRoles COLLECTION path itself (subscribeNode(CUSTOM_ROLES_PATH,
    // ...), CUSTOM_ROLES_PATH === 'customRoles'), never per-child. RTDB
    // evaluates a read request's .read rule at the EXACT requested path and
    // its ancestors ONLY — a rule that exists solely on the $roleId CHILD
    // below never satisfies a read issued at the customRoles PARENT, so
    // with root .read: false and (until this line) no .read on customRoles
    // itself, that collection subscription was silently denied for every
    // role, including admin. This is what role-management-center.js and
    // User Management's Manajemen User screen (both of which call
    // initCustomRolesStore() — see js/app.js) actually depend on to list
    // Custom Roles at all. New .read is DELIBERATELY admin/developer ONLY —
    // NOT this file's usual admin/developer/adminEquivalent-read convention
    // used by its 22 sibling admin-owned nodes (see e.g. "events"/
    // "vehicles" above). Proven empirically while writing this fix's own
    // emulator suite (custom-roles-collection-read-check.mjs): RTDB rules
    // CASCADE DOWNWARD — a .read rule that evaluates true at a PARENT node
    // is granted immediately and short-circuits before any narrower CHILD
    // rule is ever consulted. The $roleId child rule below deliberately
    // excludes adminEquivalent from reading ARCHIVED records (only admin/
    // developer bypass the archived check there; everyone else, including
    // adminEquivalent, only ever gets the "auth != null && !archived"
    // branch) — a pre-existing, intentional asymmetry this file's own
    // custom-role-archived-rule-check.mjs already documents and tests.
    // Including adminEquivalent in a COLLECTION-level rule here would
    // silently WIDEN that boundary (adminEquivalent would gain read access
    // to every archived Custom Role record, at both the collection AND,
    // via cascade, the child path) — a real authorization broadening this
    // fix must not introduce. admin/developer both ALREADY have
    // unconditional (including-archived) child-level access, so granting
    // them the same at the collection level adds no new privilege, only
    // fixes the broken bulk read. The $roleId child .read, its
    // "permissions" -> "$index" .validate (v1.30.9.10), and .write below are
    // completely UNCHANGED — this adds only the missing collection-level
    // .read as a new sibling key, closing the same class of "architecture-
    // mismatch: parent-level bulk subscribe vs. child-scoped rule" gap
    // v1.30.9.11 explicitly identified and deliberately left untouched.
    "customRoles": {
      ".read": "auth.token.role === 'admin' || auth.token.role === 'developer'",
      "$roleId": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || (auth != null && data.child('archived').val() !== true)",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin' && newData.val() !== 'system.users.manage'"
          }
        }
      },
      ".write": "auth.token.role === 'admin'"
    },

    "userPermissionOverrides": {
      "$username": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.uid === $username",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".validate": "newData.hasChildren(['permissions']) && !newData.hasChild('role') && !newData.hasChild('adminEquivalent') && !newData.hasChild('pin') && !newData.hasChild('pinHash') && !newData.hasChild('active') && !newData.hasChild('archived')",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin'"
          }
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },

    // Role-Level Permission Assignment, Phase 4 (v1.30.9.9) — bulk
    // "Role Additional Permissions" applied to every user holding a given
    // SYSTEM role (Custom Roles already have their own mutable permission
    // set via /customRoles and never target this node — enforced at the
    // application layer by role-permission-overrides-rules.js#
    // isValidRoleOverrideTarget(), not by this rule, which has no way to
    // distinguish a System Role id from a Custom Role id by shape alone).
    //
    // READ has TWO branches, deliberately: admin/adminEquivalent (the two
    // admin UIs — Role Management and User Management's Individual
    // Permission panel — read one role at a time, on selection) AND
    // `auth.token.role === $roleId`, a per-role self-read exactly
    // mirroring userPermissionOverrides' `auth.uid === $username` branch
    // above, translated from per-user identity to per-role identity since
    // a role is shared by many users and has no uid of its own. This
    // self-read is NOT optional: without it, a non-admin session could
    // never resolve its OWN role's Additional grants, and the feature
    // could not function for anyone but admin — the exact same reasoning
    // that justified userPermissionOverrides' self-branch. A role's node
    // is never readable by a DIFFERENT role's session (cross-role reads
    // stay denied) and never by an unauthenticated client.
    //
    // WRITE is admin/adminEquivalent ONLY — no self-write branch of any
    // kind (no role ever legitimately writes its own bulk grants; only an
    // administrator does), matching userPermissionOverrides' "no self-
    // write branch at all" discipline exactly.
    //
    // VALIDATE mirrors userPermissionOverrides' shape byte-for-byte, with
    // TWO forbidden permission ids instead of one — 'system.users.manage'
    // is a hard boundary here (Phase 4's own brief), unlike Individual
    // Permission Assignment where it is only a UI-layer exclusion.
    "rolePermissionOverrides": {
      "$roleId": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true || auth.token.role === $roleId",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".validate": "newData.hasChildren(['permissions']) && !newData.hasChild('role') && !newData.hasChild('adminEquivalent') && !newData.hasChild('pin') && !newData.hasChild('pinHash') && !newData.hasChild('active') && !newData.hasChild('archived')",
        "permissions": {
          "$index": {
            ".validate": "newData.isString() && newData.val() !== 'system.admin' && newData.val() !== 'system.users.manage'"
          }
        },
        "updatedAt": {
          ".validate": "newData.isString()"
        }
      }
    },

    "v2_sarpras": {
      "import_sessions": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "import_batches": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "file_storage": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      },
      "composer_documents": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
      }
    },

    // v1.30.9.11 — Phase 5, closing a gap found during Phase 5A's own
    // investigation: this node has had NO rule at all since the
    // persistence layer was introduced (v1.16.4.11-rc.1) — confirmed via
    // `git log -S"dispatchIntelligence" -- database.rules.json` (zero
    // hits, ever) and via a direct fetch of the LIVE deployed rules
    // (byte-identical to this file before this change). Root is
    // deny-by-default, so every read/write has been silently denied for
    // everyone, including admin, since whichever prior deploy hardened
    // the root — real production data up to 2026-08-11 proves this
    // subsystem DID persist successfully before that point; it has been
    // effectively frozen since. js/services/dispatch-intelligence-
    // persistence.js's own read-through/write-through pair (override
    // logs, request recommendation history, capacity snapshots) is
    // genuinely admin/ops-sensitive operational history, not a public or
    // broadly-authenticated-readable config store — deliberately
    // NARROWER than this file's usual "admin/developer/adminEquivalent
    // read" convention (no 'developer' branch): this task's own explicit
    // decision tree specified admin/adminEquivalent only for both read
    // and write, and unlike the sibling analytics/audit nodes above,
    // nothing in the application currently needs a 'developer' session to
    // read this node, so it is not added speculatively.
    "dispatchIntelligence": {
      ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
      ".write": "auth.token.role === 'admin' || auth.token.adminEquivalent === true"
    },

    "engineering": {
      "assignments": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".indexOn": ["status", "priority", "category"],
        "$assignmentId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || ((auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member') && data.exists() && newData.exists() && data.child('status').val() !== 'verified')",
          ".validate": "newData.hasChildren(['id', 'status'])"
        }
      },
      "notifications": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'"
      },
      "settings": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer'"
      },
      "workReports": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'",
        ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.role === 'engineering_coordinator' || auth.token.role === 'engineering_member'"
      }
    },

    "gudang": {
      "items": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$itemId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && (!data.exists() || newData.child('itemType').val() === data.child('itemType').val())",
          ".validate": "newData.hasChildren(['itemId', 'name', 'itemType', 'active', 'normalizedName', 'searchTokens', 'createdAt']) && newData.child('itemId').val() === $itemId"
        }
      },

      "movements": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$movementId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && !data.exists()",
          ".validate": "newData.hasChildren(['movementId', 'itemId', 'type', 'quantityDelta', 'reason', 'actorId', 'createdAt']) && newData.child('movementId').val() === $movementId && newData.child('quantityDelta').isNumber()"
        }
      },

      "assets": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$assetId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['assetId', 'itemId', 'identity', 'status', 'createdAt']) && newData.child('assetId').val() === $assetId"
        }
      },

      "assetHistory": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$historyId": {
          ".write": "(auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true) && !data.exists()",
          ".validate": "newData.hasChildren(['historyId', 'assetId', 'eventType', 'actorId', 'reason', 'occurredAt']) && newData.child('historyId').val() === $historyId"
        }
      },

      "locations": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$locationId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['locationId', 'name', 'createdAt']) && newData.child('locationId').val() === $locationId"
        }
      },

      "departments": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$departmentId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['departmentId', 'name', 'createdAt']) && newData.child('departmentId').val() === $departmentId"
        }
      },

      "stockProjection": {
        ".read": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
        "$itemId": {
          ".write": "auth.token.role === 'admin' || auth.token.role === 'developer' || auth.token.adminEquivalent === true",
          ".validate": "newData.hasChildren(['itemId', 'quantity', 'rebuiltAt', 'consistent']) && newData.child('itemId').val() === $itemId && newData.child('quantity').isNumber()"
        }
      }
    },

    // V1.31 Agenda & To-Do — Phase C1 Data + Rules Foundation (design docs:
    // docs/AGENDA_TODO_PHASE_B_ARCHITECTURE_VALIDATION_v1.31.0.0.md,
    // docs/AGENDA_TODO_PHASE_B1_SECURITY_CORRECTION_v1.31.0.0.md). Canonical
    // records are client-direct-write, Rules-gated (same shape as assignments/
    // driver_requests); agendaAudit and the four derived-index nodes below are
    // NOT client-writable — they are written only by the C2 Cloud Functions
    // (onAgendaEventWrite/onAgendaTaskWrite, onAgendaEvent/TaskIndexSync), not
    // yet built as of C1.
    //
    // Every accepted write to agendaEvents/agendaTasks self-attributes
    // updatedBy === auth.uid on EVERY branch (create AND update, organizer/PIC/
    // admin/Kabid alike — not just the create branch the way driver_requests'
    // requesterId check only covers one branch). This is deliberate and is
    // what makes agendaAudit's actor field trustworthy downstream (a value the
    // Rules already refused to let be forged, not a "best-effort" field like
    // the legacy assignment/request events' deriveActor() — see the Phase B.1
    // doc's §4 for the full reasoning) — never weaken this to a create-only
    // check.
    //
    // auth.token.agendaKabid is a PLANNED custom claim (Phase B §2.1 Plan A) —
    // NOT yet minted by verifyPin.js as of C1 (that is explicit C2/auth work,
    // deliberately deferred). These rules reference it now so the rules text
    // itself does not need to change again once C2 adds the claim; until then
    // no production user can ever satisfy this branch, so the Kabid scope is
    // effectively unreachable in production (not a live gap).
    "agendaEvents": {
      "$eventId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).exists() || data.child('organizerUsername').val() === auth.uid || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))",
        ".write": "auth != null && newData.exists() && newData.child('updatedBy').val() === auth.uid && ((!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('organizerUsername').val() === auth.uid && ((newData.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (newData.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))) || (data.exists() && newData.child('organizerUsername').val() === data.child('organizerUsername').val() && newData.child('scope').val() === data.child('scope').val() && newData.child('createdBy').val() === data.child('createdBy').val() && (data.child('organizerUsername').val() === auth.uid || data.child('participants').child(auth.uid).child('isPic').val() === true || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))))",
        ".validate": "newData.hasChildren(['id', 'title', 'scope', 'organizerUsername', 'status', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt']) && newData.child('id').val() === $eventId && (newData.child('scope').val() === 'sarpras_shared' || newData.child('scope').val() === 'kabid')",

        // C3.1 self-RSVP — the ONE narrow exception to "only organizer/PIC/
        // admin may write this event". RTDB cascade grants downward from any
        // ancestor OR descendant rule that evaluates true (a `false`/absent
        // rule at $eventId above does not block a `true` rule declared here,
        // per this file's own cascade doc at agendaAudit above — that note is
        // about an UNDECLARED deeper rule, not a blocked one; a declared
        // deeper `true` always applies). Deliberately scoped to exactly
        // `participants/$uid` so it can NEVER be reached by any write that
        // also touches title/date/location/organizer/scope/PIC/other
        // participants/creator — those all live under the $eventId node
        // itself, which this rule cannot grant (it only ever evaluates for
        // a write whose target path is participants/$uid or a descendant).
        // A caller cannot smuggle an event-root field change through the
        // SAME multi-location update as an RSVP write either: RTDB requires
        // every touched leaf in an update() to be independently granted, and
        // this rule grants only the participants/$uid leaf.
        "participants": {
          "$uid": {
            // auth.uid===$uid: only the participant themself, never another
            // participant or an outsider. data.exists(): the entry must
            // already have been created by the organizer/PIC invite flow —
            // this can never be used to self-invite. isPic/invitedBy/
            // invitedAt equality-locked (same idiom as users/$username
            // above) — RSVP can change status and nothing else. status
            // restricted to the 3 RSVP outcomes; reverting to 'invited' (the
            // only other schema value) is not offered by this grant, since
            // no UI surfaces that action.
            ".write": "auth != null && auth.uid === $uid && data.exists() && newData.exists() && newData.child('isPic').val() === data.child('isPic').val() && newData.child('invitedBy').val() === data.child('invitedBy').val() && newData.child('invitedAt').val() === data.child('invitedAt').val() && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'declined' || newData.child('status').val() === 'tentative')",
            ".validate": "newData.hasChildren(['isPic', 'status', 'invitedBy', 'invitedAt'])"
          }
        }
      }
    },

    "agendaTasks": {
      "$taskId": {
        ".read": "auth != null && (data.child('responsible').child(auth.uid).exists() || data.child('createdBy').val() === auth.uid || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))",
        ".write": "auth != null && newData.exists() && newData.child('updatedBy').val() === auth.uid && ((!data.exists() && newData.child('createdBy').val() === auth.uid && ((newData.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (newData.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))) || (data.exists() && newData.child('scope').val() === data.child('scope').val() && newData.child('createdBy').val() === data.child('createdBy').val() && (data.child('createdBy').val() === auth.uid || data.child('responsible').child(auth.uid).exists() || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))))",
        ".validate": "newData.hasChildren(['id', 'title', 'scope', 'status', 'priority', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt']) && newData.child('id').val() === $taskId && (newData.child('scope').val() === 'sarpras_shared' || newData.child('scope').val() === 'kabid')"
      }
    },

    // Server-authoritative audit (Phase B.1 §3/§11 — corrects Phase B's
    // originally-client-writable draft). NO .write is declared anywhere in the
    // $auditId subtree, so the collection-level "false" is the only rule that
    // ever applies at any descendant path (RTDB rule cascade only ever GRANTS
    // downward from an ancestor that evaluates true — it can never re-open a
    // write a stricter ancestor already closed). Written exclusively by the C2
    // onAgendaEventWrite/onAgendaTaskWrite Cloud Functions via the Admin SDK,
    // which bypasses these rules by construction — same shape as /userProfiles
    // and /reminders, both already .write:false / trigger-owned.
    "agendaAudit": {
      ".write": "false",
      ".indexOn": ["entityId"],
      "$auditId": {
        ".read": "auth != null && ((data.child('entityScope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('entityScope').val() === 'kabid' && auth.token.agendaKabid === true))"
      }
    },

    // Derived indexes (Phase B §3) — NEVER a source of truth (the canonical
    // agendaEvents/agendaTasks records above are independently re-checked on
    // every read regardless of how a client learned the id — a stale or even
    // corrupted index entry can cause a UX gap, never an authorization leak).
    // NEVER client-writable — populated only by the C2 onAgendaEvent/
    // TaskIndexSync triggers. Deliberately STRICTER than this file's usual
    // admin-bypass convention: even the fact that an event/task id exists in
    // the "kabid" bucket is calendar data admin must not see merely by being
    // admin (Phase B §2.6 / Phase B.1 §10) — there is no admin branch on the
    // kabid leg of either index, unlike every other admin-tier node in this
    // file.
    "agendaEventsByUser": {
      ".write": "false",
      "$username": {
        ".read": "auth.uid === $username",
        ".indexOn": ".value"
      }
    },
    "agendaEventsByScope": {
      ".write": "false",
      "sarpras_shared": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".indexOn": ".value"
      },
      "kabid": {
        ".read": "auth.token.agendaKabid === true",
        ".indexOn": ".value"
      }
    },
    "agendaTasksByUser": {
      ".write": "false",
      "$username": {
        ".read": "auth.uid === $username",
        ".indexOn": ".value"
      }
    },
    "agendaTasksByScope": {
      ".write": "false",
      "sarpras_shared": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".indexOn": ".value"
      },
      "kabid": {
        ".read": "auth.token.agendaKabid === true",
        ".indexOn": ".value"
      }
    },

    // V1.31.1 Agenda, Kalender & To-Do — Calendar entity. Byte-for-byte the
    // SAME read/write/validate SHAPE as agendaEvents above (organizer/PIC/
    // scope-bypass write, participant/organizer/scope-bypass read, the one
    // narrow participants/$uid self-RSVP carve-out, updatedBy===auth.uid on
    // every branch, organizerUsername/scope/createdBy immutable after
    // create) — deliberately reusing the exact same authorization
    // architecture rather than inventing a parallel one, since Calendar
    // shares the identical Sarpras-staff/Kabid population and scope model
    // as Agenda. status has no enum .validate (matching agendaEvents'
    // existing convention, where 'scheduled'/'cancelled' aren't Rules-
    // enforced either) — 'deleted' (soft-delete/"Dihapus") is therefore
    // already writable without any further Rules change, exactly as it now
    // is for agendaEvents/agendaTasks. agendaAudit below is intentionally
    // NOT duplicated for Calendar — its existing rule already reads by the
    // record's own entityScope field, not a per-entity-type path, so a
    // Calendar audit row (entityType: 'agendaCalendar') is covered for
    // free.
    "agendaCalendars": {
      "$calendarId": {
        ".read": "auth != null && (data.child('participants').child(auth.uid).exists() || data.child('organizerUsername').val() === auth.uid || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))",
        ".write": "auth != null && newData.exists() && newData.child('updatedBy').val() === auth.uid && ((!data.exists() && newData.child('createdBy').val() === auth.uid && newData.child('organizerUsername').val() === auth.uid && ((newData.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (newData.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))) || (data.exists() && newData.child('organizerUsername').val() === data.child('organizerUsername').val() && newData.child('scope').val() === data.child('scope').val() && newData.child('createdBy').val() === data.child('createdBy').val() && (data.child('organizerUsername').val() === auth.uid || data.child('participants').child(auth.uid).child('isPic').val() === true || (data.child('scope').val() === 'sarpras_shared' && (auth.token.role === 'admin' || auth.token.adminEquivalent === true)) || (data.child('scope').val() === 'kabid' && auth.token.agendaKabid === true))))",
        ".validate": "newData.hasChildren(['id', 'title', 'scope', 'organizerUsername', 'status', 'startDate', 'endDate', 'allDay', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt']) && newData.child('id').val() === $calendarId && (newData.child('scope').val() === 'sarpras_shared' || newData.child('scope').val() === 'kabid')",

        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.exists() && newData.exists() && newData.child('isPic').val() === data.child('isPic').val() && newData.child('invitedBy').val() === data.child('invitedBy').val() && newData.child('invitedAt').val() === data.child('invitedAt').val() && (newData.child('status').val() === 'accepted' || newData.child('status').val() === 'declined' || newData.child('status').val() === 'tentative')",
            ".validate": "newData.hasChildren(['isPic', 'status', 'invitedBy', 'invitedAt'])"
          }
        }
      }
    },

    "agendaCalendarsByUser": {
      ".write": "false",
      "$username": {
        ".read": "auth.uid === $username",
        ".indexOn": ".value"
      }
    },
    "agendaCalendarsByScope": {
      ".write": "false",
      "sarpras_shared": {
        ".read": "auth.token.role === 'admin' || auth.token.adminEquivalent === true",
        ".indexOn": ".value"
      },
      "kabid": {
        ".read": "auth.token.agendaKabid === true",
        ".indexOn": ".value"
      }
    }
  }
}
